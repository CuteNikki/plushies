# Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/plushies"

# Random string, e.g. from `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Where the site runs
BETTER_AUTH_URL="http://localhost:3000"

# From https://discord.com/developers/applications > OAuth2
# Redirect URL: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# From https://uploadthing.com/dashboard > API Keys
UPLOADTHING_TOKEN=""

# From https://resend.com/api-keys, used for password reset emails.
# EMAIL_FROM must use a domain you've verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Plushies <noreply@example.com>"
