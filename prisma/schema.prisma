generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Plushie {
  id          String   @id @default(cuid())
  /// Used in the URL, e.g. /plushies/mochi.
  slug        String   @unique
  name        String
  species     String?
  /// Birthday as YYYY, YYYY-MM or YYYY-MM-DD, as precise as is known.
  birthday    String?
  gender      String?
  pronouns    String?
  description String
  origin      String?
  /// Extra facts as an ordered list of { label, value } pairs.
  facts       Json     @default("[]")
  traits      String[] @default([])

  /// UploadThing file key and URL of the main photo.
  thumbnailKey String?
  thumbnailUrl String?
  gallery      PlushieImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plushie")
}

model PlushieImage {
  id        String   @id @default(cuid())
  plushieId String
  plushie   Plushie  @relation(fields: [plushieId], references: [id], onDelete: Cascade)
  /// UploadThing file key, used to delete the file.
  key       String   @unique
  url       String
  position  Int
  createdAt DateTime @default(now())

  @@index([plushieId, position])
  @@map("plushie_image")
}

// Better Auth tables (core + admin plugin)

/// What an account may do. Better Auth's admin plugin uses these exact names.
enum Role {
  /// Everything, including managing users and their roles.
  ADMIN
  /// Can add, edit and delete plushies.
  EDITOR
  /// Signed in, but can only look.
  USER
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Activity log

/// What an activity entry is about.
enum ActivitySubject {
  PLUSHIE
  USER
}

/// What happened. CREATED, UPDATED and DELETED apply to plushies and users;
/// the rest only to users.
enum ActivityType {
  CREATED
  UPDATED
  DELETED
  /// Changed or reset, never with the password itself.
  PASSWORD_CHANGED
  /// A sign-in method was added, e.g. Discord or a password.
  LINKED
  UNLINKED
  /// An admin ended all of their sessions.
  SIGNED_OUT
  /// An admin sent them a password reset link.
  PASSWORD_RESET_SENT
}

/// A change to a plushie or user, kept for 90 days.
model Activity {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  type        ActivityType
  subject     ActivitySubject
  /// The plushie's or user's id. Not a relation, so entries outlive them.
  subjectId   String
  /// Their name at the time, for when they have been deleted since.
  subjectName String
  /// Who made the change. Null if their account no longer existed.
  actorId     String?
  actorName   String?
  /// The relevant fields before and after the change.
  before      Json?
  after       Json?

  @@index([createdAt])
  @@index([subject, createdAt])
  @@map("activity")
}
