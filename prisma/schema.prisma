generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Plushie {
  id          String   @id @default(cuid())
  /// Used in the URL, e.g. /plushies/mochi.
  slug        String   @unique
  name        String
  species     String?
  /// Birthday as YYYY, YYYY-MM or YYYY-MM-DD, as precise as is known.
  birthday    String?
  gender      String?
  pronouns    String?
  description String
  origin      String?
  /// Extra facts as an ordered list of { label, value } pairs.
  facts       Json     @default("[]")
  traits      String[] @default([])

  /// UploadThing file key and URL of the main photo.
  thumbnailKey String?
  thumbnailUrl String?
  gallery      PlushieImage[]
  likes        PlushieLike[]
  comments     Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plushie")
}

model PlushieImage {
  id        String   @id @default(cuid())
  plushieId String
  plushie   Plushie  @relation(fields: [plushieId], references: [id], onDelete: Cascade)
  /// UploadThing file key, used to delete the file.
  key       String   @unique
  url       String
  position  Int
  createdAt DateTime @default(now())

  @@index([plushieId, position])
  @@map("plushie_image")
}

/// A comment on a plushie's page. Replies nest under the comment they
/// answer, as deep as people go.
model Comment {
  id             String          @id @default(cuid())
  plushieId      String
  plushie        Plushie         @relation(fields: [plushieId], references: [id], onDelete: Cascade)
  /// Null only on a deleted comment kept for its replies.
  authorId       String?
  author         User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// The top-level comment the thread started with; null for top-level ones.
  /// Lets a page load whole threads at once.
  threadId       String?
  thread         Comment?        @relation("Thread", fields: [threadId], references: [id], onDelete: Cascade)
  threadComments Comment[]       @relation("Thread")
  /// The comment this answers; null for top-level ones.
  parentId       String?
  parent         Comment?        @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]       @relation("Replies")
  /// Plain text. Empty on a deleted comment kept for its replies.
  body           String
  createdAt      DateTime        @default(now())
  editedAt       DateTime?
  /// Set on a comment that was deleted while it had replies. It shows as
  /// "[deleted]" and goes once its last reply does.
  deletedAt      DateTime?
  /// Set once enough people report it in a short time (see comment-rules).
  /// Only its author and editors or admins see it until one of them keeps
  /// it, which clears this, or deletes it.
  hiddenAt       DateTime?
  reports        CommentReport[]

  @@index([plushieId, threadId, createdAt])
  @@index([threadId, createdAt])
  @@index([parentId])
  @@index([authorId, createdAt])
  @@map("comment")
}

/// A signed-in account liking a plushie. The key allows one per account.
model PlushieLike {
  plushieId String
  plushie   Plushie  @relation(fields: [plushieId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([plushieId, userId])
  @@index([userId])
  @@map("plushie_like")
}

// Better Auth tables (core + admin plugin)

/// What an account may do. Better Auth's admin plugin uses these exact names.
enum Role {
  /// Everything, including managing users and their roles.
  ADMIN
  /// Can add, edit and delete plushies.
  EDITOR
  /// Signed in, but can only look.
  USER
}

model User {
  id               String          @id
  name             String
  email            String          @unique
  emailVerified    Boolean         @default(false)
  image            String?
  role             Role            @default(USER)
  /// Whether signing in with a password asks for a second step.
  twoFactorEnabled Boolean?        @default(false)
  banned           Boolean?        @default(false)
  banReason        String?
  /// When the ban ends by itself. Null bans for good.
  banExpires       DateTime?
  /// The admin who banned them, and when. Better Auth doesn't know these,
  /// and leaves them behind when a ban expires, so check banned first.
  bannedById       String?
  bannedBy         User?           @relation("BannedBy", fields: [bannedById], references: [id], onDelete: SetNull)
  bannedAt         DateTime?
  /// Accounts this admin banned.
  usersBanned      User[]          @relation("BannedBy")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  passkeys         Passkey[]
  likes            PlushieLike[]
  comments         Comment[]
  /// Comments this account reported, and reports it dealt with.
  reportsMade      CommentReport[] @relation("ReportedBy")
  reportsResolved  CommentReport[] @relation("ResolvedBy")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// An authenticator app set up for two-step sign-in, with backup codes.
/// Accounts using email codes only have none.
model TwoFactor {
  id                      String    @id
  /// Encrypted by Better Auth, like the backup codes.
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// False until the first code from the app confirms it's set up.
  verified                Boolean?  @default(true)
  /// For locking sign-in after too many wrong codes.
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

/// A passkey someone can sign in with instead of a password.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  /// Which kind of authenticator made it, when it says.
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Activity log

/// What an activity entry is about.
enum ActivitySubject {
  PLUSHIE
  USER
  /// Only comments editors or admins deleted from someone else.
  COMMENT
}

/// What happened. CREATED, UPDATED and DELETED apply to plushies and users;
/// the rest only to users.
enum ActivityType {
  CREATED
  UPDATED
  DELETED
  /// Changed or reset, never with the password itself.
  PASSWORD_CHANGED
  /// A sign-in method was added, e.g. Discord or a password.
  LINKED
  UNLINKED
  /// An admin ended all of their sessions.
  SIGNED_OUT
  /// An admin sent them a password reset link.
  PASSWORD_RESET_SENT
  /// An admin started viewing the site as them.
  IMPERSONATED
  /// An admin banned them, with the reason and when it ends.
  BANNED
  /// An admin lifted their ban early.
  UNBANNED
}

/// A change to a plushie or user, kept for 90 days.
model Activity {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  type        ActivityType
  subject     ActivitySubject
  /// The plushie's, user's or comment's id. Not a relation, so entries
  /// outlive them.
  subjectId   String
  /// Their name at the time, for when they have been deleted since.
  subjectName String
  /// Who made the change. Null if their account no longer existed.
  actorId     String?
  actorName   String?
  /// The relevant fields before and after the change.
  before      Json?
  after       Json?
  /// For reverts: the entry whose change this undid.
  revertOf    String?

  @@index([createdAt])
  @@index([subject, createdAt])
  @@map("activity")
}

/// Why someone reported a comment.
enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  OTHER
}

/// What an editor or admin decided about a reported comment.
enum ReportOutcome {
  KEPT
  DELETED
}

/// Someone flagging a comment for editors and admins to look at. Each
/// account can report a comment once. Open until the comment is kept or
/// deleted, which closes every open report on it.
model CommentReport {
  id           String         @id @default(cuid())
  commentId    String
  comment      Comment        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// Null once their account is deleted; the report still counts.
  reporterId   String?
  reporter     User?          @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: SetNull)
  reason       ReportReason
  /// What they added, if anything.
  note         String?
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?          @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  outcome      ReportOutcome?

  @@unique([commentId, reporterId])
  @@index([resolvedAt, createdAt])
  @@map("comment_report")
}
